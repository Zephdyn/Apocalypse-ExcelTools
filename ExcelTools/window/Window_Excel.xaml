<Window
    x:Class="ExcelTools.window.Window_Excel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ExcelTools.window"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
    xmlns:wpf="clr-namespace:excelTools.WPF"
    Title="Window"
    Width="1000"
    Height="665"
    MinWidth="1000"
    MinHeight="665"
    d:DataContext="{d:DesignInstance Type=wpf:WpfInfo}"
    AllowsTransparency="True"
    FontFamily="HarmonyOS Sans SC"
    KeyDown="Window_PreviewKeyDown"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Grid Background="#9E9E9E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="560*" />
        </Grid.RowDefinitions>
        <!--  顶层  -->
        <Grid
            x:Name="顶层"
            Grid.Row="0"
            Width="NaN"
            Height="NaN"
            Margin="1,1,1,0"
            Background="White"
            MouseDown="Grid_MouseDown"
            MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <!--  边框  -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" />
            <Image
                x:Name="image"
                Width="32"
                Height="32"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/window/logo.png" />
            <TextBlock
                x:Name="textBlock"
                Margin="50,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="Excel Tools - 数据导入"
                TextWrapping="Wrap" />
            <Button
                x:Name="顶层_最大"
                Width="35"
                Height="35"
                Margin="0,10,70,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                pu:ButtonHelper.CornerRadius="17.5"
                pu:ButtonHelper.HoverForeground="Gray"
                pu:ButtonHelper.ShadowColor="LightGray"
                pu:ShadowHelper.BlurRadius="15"
                pu:ShadowHelper.Opacity="0.8"
                pu:ShadowHelper.ShadowDepth="5"
                Background="White"
                Click="顶层_最大_Click"
                Content="&#xe92b;"
                Focusable="False"
                FontFamily="{StaticResource PanuonIconFont}"
                FontSize="16" />
            <Button
                x:Name="顶层_关闭"
                Width="35"
                Height="35"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                pu:ButtonHelper.CornerRadius="17.5"
                pu:ButtonHelper.HoverForeground="Red"
                pu:ButtonHelper.ShadowColor="LightGray"
                pu:ShadowHelper.BlurRadius="15"
                pu:ShadowHelper.Opacity="0.8"
                pu:ShadowHelper.ShadowDepth="5"
                Background="White"
                Click="顶层_关闭_Click"
                Content="&#xe92d;"
                Focusable="False"
                FontFamily="{StaticResource PanuonIconFont}"
                FontSize="16" />
        </Grid>
        <!--  功能  -->
        <Grid
            x:Name="功能"
            Grid.Row="1"
            Margin="1,0,1,1"
            Background="White">
            <!--  边框  -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" />
            <Grid Background="#FFF">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="307*" />
                    <ColumnDefinition Width="319*" />
                    <ColumnDefinition Width="340*" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45" />
                    <RowDefinition />
                    <RowDefinition Height="60" />
                </Grid.RowDefinitions>
                <DataGrid
                    x:Name="Tab_3_DataGrid"
                    Grid.Row="1"
                    Grid.Column="1"
                    Grid.ColumnSpan="3"
                    Width="Auto"
                    AutoGenerateColumns="False"
                    ColumnWidth="*"
                    ItemsSource="{Binding}"
                    RowHeaderWidth="0" />
                <Button
                    Grid.Row="2"
                    Grid.Column="3"
                    Grid.ColumnSpan="2"
                    Width="80"
                    Height="30"
                    Margin="0,8,10,10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    pu:ButtonHelper.CornerRadius="2"
                    pu:ButtonHelper.HoverBackground="#F1F1F1"
                    pu:IconHelper.Margin="0,0,7,0"
                    Background="Transparent"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Click="Button_Click_Writedata"
                    Content="开始导入" />
                <TextBlock
                    x:Name="Tab_3_TextBlock"
                    Grid.Column="1"
                    Width="304"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    x:FieldModifier="public"
                    FontSize="14"
                    TextWrapping="Wrap"><Run Text="当前数据数量: " /><Run Text="0" /></TextBlock>
                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Width="304"
                    Margin="10,14,0,14"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="14"
                    TextAlignment="Left"
                    TextWrapping="Wrap"><Run Text="最多展示" /><Run Language="zh-cn" Text="5" /><Run Text="0" /><Run Text="条数据" /></TextBlock>
                <Canvas
                    Grid.Row="1"
                    Grid.Column="3"
                    Width="100"
                    Height="100"
                    Margin="36,182,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />
                <TextBlock
                    Grid.Column="2"
                    Width="304"
                    Margin="5,10,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Text="{Binding TabWriteDataNum}"
                    TextWrapping="Wrap" />
                <ComboBox
                    x:Name="Tab_3_ComboBox_Shhet"
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="121"
                    Height="26"
                    Margin="90,10,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    DisplayMemberPath="Name"
                    SelectedValuePath="ID" />
                <Button
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="80"
                    Height="30"
                    Margin="229,6,0,10"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    pu:ButtonHelper.CornerRadius="2"
                    pu:ButtonHelper.HoverBackground="#F1F1F1"
                    pu:IconHelper.Margin="0,0,7,0"
                    Background="Transparent"
                    BorderBrush="LightGray"
                    BorderThickness="1"
                    Click="Button_Click_GetShee"
                    Content="读取表" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="2"
                    Width="85"
                    Margin="0,13,0,15"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    FontSize="14"
                    TextAlignment="Center"
                    TextWrapping="Wrap"><Run Language="zh-cn" Text="工作表" /></TextBlock>
            </Grid>
        </Grid>
    </Grid>
</Window>
