<Window
    x:Class="ExcelTools.window.Main"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ExcelTools.window"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:pu="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
    xmlns:wpf="clr-namespace:excelTools.WPF"
    Title="Window"
    Width="1000"
    Height="665"
    MinWidth="1000"
    MinHeight="665"
    d:DataContext="{d:DesignInstance Type=wpf:WpfInfo}"
    AllowsTransparency="True"
    FontFamily="HarmonyOS Sans SC"
    KeyDown="Window_PreviewKeyDown"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Grid Background="#9E9E9E">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="560*" />
        </Grid.RowDefinitions>
        <!--  顶层  -->
        <Grid
            x:Name="顶层"
            Grid.Row="0"
            Width="NaN"
            Height="NaN"
            Margin="1,1,1,0"
            Background="White"
            MouseDown="Grid_MouseDown"
            MouseLeftButtonDown="Grid_MouseLeftButtonDown">
            <!--  边框  -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" />
            <Image
                x:Name="image"
                Width="32"
                Height="32"
                Margin="10,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Source="/window/logo.png" />
            <TextBlock
                x:Name="textBlock"
                Margin="50,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="20"
                FontWeight="Bold"
                Text="天启幻境II - Excel Tools"
                TextWrapping="Wrap" />
            <Button
                x:Name="顶层_缩小"
                Width="35"
                Height="35"
                Margin="0,10,130,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                pu:ButtonHelper.CornerRadius="17.5"
                pu:ButtonHelper.HoverForeground="Gray"
                pu:ButtonHelper.ShadowColor="LightGray"
                pu:ShadowHelper.BlurRadius="15"
                pu:ShadowHelper.Opacity="0.8"
                pu:ShadowHelper.ShadowDepth="5"
                Background="White"
                Click="顶层_缩小_Click"
                Content="&#xe92a;"
                Focusable="False"
                FontFamily="{StaticResource PanuonIconFont}"
                FontSize="16" />
            <Button
                x:Name="顶层_最大"
                Width="35"
                Height="35"
                Margin="0,10,70,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                pu:ButtonHelper.CornerRadius="17.5"
                pu:ButtonHelper.HoverForeground="Gray"
                pu:ButtonHelper.ShadowColor="LightGray"
                pu:ShadowHelper.BlurRadius="15"
                pu:ShadowHelper.Opacity="0.8"
                pu:ShadowHelper.ShadowDepth="5"
                Background="White"
                Click="顶层_最大_Click"
                Content="&#xe92b;"
                Focusable="False"
                FontFamily="{StaticResource PanuonIconFont}"
                FontSize="16" />
            <Button
                x:Name="顶层_关闭"
                Width="35"
                Height="35"
                Margin="0,10,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                pu:ButtonHelper.CornerRadius="17.5"
                pu:ButtonHelper.HoverForeground="Red"
                pu:ButtonHelper.ShadowColor="LightGray"
                pu:ShadowHelper.BlurRadius="15"
                pu:ShadowHelper.Opacity="0.8"
                pu:ShadowHelper.ShadowDepth="5"
                Background="White"
                Click="顶层_关闭_Click"
                Content="&#xe92d;"
                Focusable="False"
                FontFamily="{StaticResource PanuonIconFont}"
                FontSize="16" />
        </Grid>
        <!--  功能  -->
        <Grid
            x:Name="功能"
            Grid.Row="1"
            Margin="1,0,1,1"
            Background="White">
            <!--  边框  -->
            <Border BorderBrush="#E0E0E0" BorderThickness="0,0,1,0" />
            <TabControl
                x:Name="功能_栏"
                Margin="0,0,0,0"
                pu:TabControlHelper.HeaderPanelBorderBrush="LightGray"
                pu:TabControlHelper.HeaderPanelBorderThickness="0,0,0.5,0"
                pu:TabControlHelper.ItemsBorderThickness="0,0,3,0"
                pu:TabControlHelper.ItemsFontFamily="{StaticResource PanuonIconFont}"
                pu:TabControlHelper.ItemsFontSize="18"
                pu:TabControlHelper.ItemsForeground="#AAAAAA"
                pu:TabControlHelper.ItemsHeight="60"
                pu:TabControlHelper.ItemsHoverBackground="{x:Null}"
                pu:TabControlHelper.ItemsSelectedBackground="{x:Null}"
                pu:TabControlHelper.ItemsSelectedBorderBrush="#81D4FA"
                pu:TabControlHelper.ItemsSelectedForeground="Black"
                pu:TabControlHelper.ItemsWidth="100"
                pu:WindowX.IsDragMoveArea="True"
                Background="Transparent"
                BorderThickness="0"
                SelectedIndex="{Binding TabControl}"
                SelectionChanged="功能_栏_SelectionChanged"
                TabStripPlacement="Left">
                <!--  首页  -->
                <TabItem x:Name="TabItem_首页" Header="&#xE941; 首页">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="420" />
                            <ColumnDefinition Width="20*" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Grid.RowSpan="3"
                            Grid.Column="1"
                            Margin="20,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <pu:Card
                                Grid.Row="1"
                                Grid.Column="0"
                                pu:ShadowHelper.BlurRadius="30"
                                pu:ShadowHelper.Direction="270"
                                pu:ShadowHelper.Opacity="0.3"
                                pu:ShadowHelper.ShadowDepth="15"
                                Background="#374361"
                                BorderThickness="0"
                                CornerRadius="10"
                                ShadowColor="#3480F1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="20*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Width="30"
                                        Margin="0,25,0,25"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        pu:LabelHelper.CornerRadius="5"
                                        Background="#44FFFFFF"
                                        Content="&#xe975;"
                                        FontFamily="{StaticResource PanuonIconFont}"
                                        FontSize="14"
                                        Foreground="White" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Height="NaN"
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="本工具可以将Excel中的数据快速导入天启幻境II" />
                                </Grid>
                            </pu:Card>
                            <pu:Card
                                Grid.Row="3"
                                Grid.Column="0"
                                Width="NaN"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                pu:ShadowHelper.BlurRadius="15"
                                pu:ShadowHelper.Direction="270"
                                pu:ShadowHelper.Opacity="0.15"
                                pu:ShadowHelper.ShadowDepth="7"
                                Background="White"
                                BorderThickness="0"
                                CornerRadius="10"
                                ShadowColor="Gray">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="20*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Width="30"
                                        Height="30"
                                        Margin="15"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        pu:LabelHelper.CornerRadius="5"
                                        Background="#BDBDBD"
                                        Content="&#xe90e;"
                                        FontFamily="{StaticResource PanuonIconFont}"
                                        FontSize="14"
                                        Foreground="White" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Width="NaN"
                                        Height="NaN"
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="步骤1: 选择连接数据库" />
                                </Grid>
                            </pu:Card>
                            <pu:Card
                                Grid.Row="5"
                                Grid.Column="0"
                                Width="NaN"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                pu:ShadowHelper.BlurRadius="15"
                                pu:ShadowHelper.Direction="270"
                                pu:ShadowHelper.Opacity="0.15"
                                pu:ShadowHelper.ShadowDepth="7"
                                Background="White"
                                BorderThickness="0"
                                CornerRadius="10"
                                ShadowColor="Gray">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="20*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Width="30"
                                        Height="30"
                                        Margin="15"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        pu:LabelHelper.CornerRadius="5"
                                        Background="#BDBDBD"
                                        Content="&#xe90e;"
                                        FontFamily="{StaticResource PanuonIconFont}"
                                        FontSize="14"
                                        Foreground="White" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Width="NaN"
                                        Height="NaN"
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="步骤2: 选择要导入的Excel" />
                                </Grid>
                            </pu:Card>
                            <pu:Card
                                Grid.Row="7"
                                Grid.Column="0"
                                Width="NaN"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch"
                                pu:ShadowHelper.BlurRadius="15"
                                pu:ShadowHelper.Direction="270"
                                pu:ShadowHelper.Opacity="0.15"
                                pu:ShadowHelper.ShadowDepth="7"
                                Background="White"
                                BorderThickness="0"
                                CornerRadius="10"
                                ShadowColor="Gray">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="20*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Width="30"
                                        Height="30"
                                        Margin="15"
                                        HorizontalAlignment="Left"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        pu:LabelHelper.CornerRadius="5"
                                        Background="#BDBDBD"
                                        Content="&#xe90e;"
                                        FontFamily="{StaticResource PanuonIconFont}"
                                        FontSize="14"
                                        Foreground="White" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Width="NaN"
                                        Height="NaN"
                                        Margin="20,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Text="步骤3: 确认,完成导入" />
                                </Grid>
                            </pu:Card>

                        </Grid>
                        <Grid Grid.RowSpan="2" Grid.Column="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="20" />
                                <RowDefinition Height="80" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <pu:Card
                                Grid.Row="1"
                                Grid.Column="0"
                                pu:ShadowHelper.BlurRadius="30"
                                pu:ShadowHelper.Direction="270"
                                pu:ShadowHelper.Opacity="0.3"
                                pu:ShadowHelper.ShadowDepth="15"
                                Background="#374361"
                                BorderThickness="0"
                                CornerRadius="10"
                                ShadowColor="#3480F1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4*" />
                                        <ColumnDefinition Width="20*" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Width="30"
                                        Margin="0,25,0,25"
                                        HorizontalAlignment="Center"
                                        HorizontalContentAlignment="Center"
                                        VerticalContentAlignment="Center"
                                        pu:LabelHelper.CornerRadius="5"
                                        Background="#44FFFFFF"
                                        Content="&#xe975;"
                                        FontFamily="{StaticResource PanuonIconFont}"
                                        FontSize="14"
                                        Foreground="White" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Height="NaN"
                                        Margin="105,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="White"
                                        Text="格式支持以下" />
                                </Grid>
                            </pu:Card>

                            <Grid Grid.Row="3" Grid.Column="0">
                                <pu:Card
                                    Width="NaN"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    pu:ShadowHelper.BlurRadius="15"
                                    pu:ShadowHelper.Direction="270"
                                    pu:ShadowHelper.Opacity="0.15"
                                    pu:ShadowHelper.ShadowDepth="7"
                                    Background="White"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    ShadowColor="Gray">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <pu:RingProgressBar
                                            BorderBrush="#EFEFEF"
                                            BorderThickness="6"
                                            Foreground="#009688"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="100" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Foreground="#FFC107"
                                            Text="★★★★★" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Bottom"
                                            FontSize="27"
                                            FontWeight="Bold"
                                            Text="XLSX" />
                                    </Grid>
                                </pu:Card>
                            </Grid>
                            <Grid Grid.Row="5" Grid.Column="0">
                                <pu:Card
                                    Width="NaN"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"
                                    pu:ShadowHelper.BlurRadius="15"
                                    pu:ShadowHelper.Direction="270"
                                    pu:ShadowHelper.Opacity="0.15"
                                    pu:ShadowHelper.ShadowDepth="7"
                                    Background="White"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    ShadowColor="Gray">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <pu:RingProgressBar
                                            BorderBrush="#EFEFEF"
                                            BorderThickness="6"
                                            Foreground="#3480F1"
                                            Maximum="100"
                                            Minimum="0"
                                            Value="75" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            Foreground="#FFC107"
                                            Text="★★★☆" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Bottom"
                                            FontSize="27"
                                            FontWeight="Bold"
                                            Text="XLS" />
                                    </Grid>
                                </pu:Card>

                            </Grid>

                        </Grid>
                    </Grid>
                </TabItem>
                <!--  功能  -->
                <TabItem x:Name="TabItem_导入" Header="&#xE9AF; 导入">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="120" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <StackPanel Margin="0,0,0,15">
                                <pu:Card
                                    Height="70"
                                    Margin="0,15,0,0"
                                    pu:ShadowHelper.BlurRadius="15"
                                    pu:ShadowHelper.Direction="270"
                                    pu:ShadowHelper.Opacity="0.15"
                                    pu:ShadowHelper.ShadowDepth="7"
                                    Background="White"
                                    BorderThickness="0"
                                    CornerRadius="10"
                                    ShadowColor="Gray">
                                    <Grid Margin="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Label
                                            Width="{Binding ActualHeight, RelativeSource={RelativeSource Self}}"
                                            HorizontalContentAlignment="Center"
                                            VerticalContentAlignment="Center"
                                            pu:LabelHelper.CornerRadius="5"
                                            Background="#69d0cb"
                                            Content="&#xe9c2;"
                                            FontFamily="{StaticResource PanuonIconFont}"
                                            FontSize="20"
                                            Foreground="White" />
                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="15,0,0,0"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="15"
                                                FontWeight="Bold"
                                                Text="数据库信息" />
                                            <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                                                <TextBlock Foreground="#757575" Text="支持：4.0.0(4000000)" />
                                                <Rectangle
                                                    Width="1"
                                                    Margin="10,0"
                                                    Fill="#EFEFEF" />
                                                <TextBlock Foreground="#757575" Text="{Binding DbConfigInfo, FallbackValue=当前版本}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Button
                                                Grid.RowSpan="3"
                                                Height="30"
                                                Padding="15,0"
                                                VerticalAlignment="Top"
                                                pu:ButtonHelper.CornerRadius="15"
                                                pu:ButtonHelper.Icon="&#xe989;"
                                                pu:IconHelper.FontFamily="{StaticResource PanuonIconFont}"
                                                pu:IconHelper.FontSize="12"
                                                pu:IconHelper.Margin="0,0,10,0"
                                                Background="{Binding DbConnectButtonBackground, FallbackValue=#FFF44336}"
                                                Click="Button_Click_OpenDB"
                                                Content="连接"
                                                Foreground="White" />
                                            <!--<ProgressBar
                                                Grid.Row="2"
                                                Height="10"
                                                Margin="0,10,0,0"
                                                pu:ProgressBarHelper.CornerRadius="5"
                                                Background="#EFEFEF"
                                                Foreground="#3480F1"
                                                Value="50" />-->
                                        </Grid>
                                    </Grid>
                                </pu:Card>

                            </StackPanel>
                        </Grid>
                        <!--  滚动条  -->
                        <Grid Grid.Row="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="1*" MinHeight="120" />
                                        <RowDefinition Height="1*" MinHeight="120" />
                                        <RowDefinition Height="1*" MinHeight="120" />
                                        <RowDefinition Height="1*" MinHeight="120" />
                                        <RowDefinition Height="1*" MinHeight="120" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition Width="100" />
                                        <ColumnDefinition Width="350" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <!--  装备  -->
                                    <Grid Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="50"
                                            Height="50"
                                            CornerRadius="25">
                                            <Border.Background>
                                                <ImageBrush ImageSource="/images/excel/equip.png" />
                                            </Border.Background>
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <StackPanel
                                                Grid.RowSpan="2"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock Text="装备" />
                                                <TextBlock Margin="0,5,0,0" Foreground="#AAAAAA"><Run Language="zh-cn" Text="角色 " /><Run Language="zh-cn" Text="增强" /><Run Language="zh-cn" Text="/" /><Run Text="装饰物" /></TextBlock>
                                            </StackPanel>
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Padding="15,0"
                                                    VerticalAlignment="Center"
                                                    pu:ButtonHelper.CornerRadius="15"
                                                    pu:IconHelper.FontFamily="{StaticResource PanuonIconFont}"
                                                    pu:IconHelper.FontSize="12"
                                                    pu:IconHelper.Margin="0,0,10,0"
                                                    Background="#03A9F4"
                                                    Click="Button_Click_Excel"
                                                    CommandParameter="1"
                                                    Content="示例导出"
                                                    Foreground="White" />
                                                <Button
                                                    Grid.Column="4"
                                                    Height="30"
                                                    Padding="15,0"
                                                    VerticalAlignment="Center"
                                                    pu:ButtonHelper.CornerRadius="15"
                                                    pu:IconHelper.FontFamily="{StaticResource PanuonIconFont}"
                                                    pu:IconHelper.FontSize="12"
                                                    pu:IconHelper.Margin="0,0,10,0"
                                                    Background="#009688"
                                                    Click="Button_Click_Excel"
                                                    CommandParameter="1"
                                                    Content="数据导入"
                                                    Foreground="White" />
                                            </Grid>

                                        </Grid>
                                    </Grid>
                                    <!--  地图  -->
                                    <Grid Grid.Column="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="50"
                                            Height="50"
                                            CornerRadius="25">
                                            <Border.Background>
                                                <ImageBrush ImageSource="/images/excel/map.png" />
                                            </Border.Background>
                                        </Border>
                                        <Grid Grid.Column="1">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <StackPanel
                                                Grid.RowSpan="2"
                                                Margin="15,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock Text="地图" />
                                                <TextBlock Margin="0,5,0,0" Foreground="#AAAAAA"><Run Language="zh-cn" Text="增加可活动范围" /></TextBlock>
                                            </StackPanel>
                                            <Grid Grid.Row="3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="120" />
                                                </Grid.ColumnDefinitions>
                                                <Button
                                                    Grid.Column="2"
                                                    Height="30"
                                                    Padding="15,0"
                                                    VerticalAlignment="Center"
                                                    pu:ButtonHelper.CornerRadius="15"
                                                    pu:IconHelper.FontFamily="{StaticResource PanuonIconFont}"
                                                    pu:IconHelper.FontSize="12"
                                                    pu:IconHelper.Margin="0,0,10,0"
                                                    Background="#03A9F4"
                                                    Click="Button_Click_Excel"
                                                    CommandParameter="2"
                                                    Content="示例导出"
                                                    Foreground="White" />
                                                <Button
                                                    Grid.Column="4"
                                                    Height="30"
                                                    Padding="15,0"
                                                    VerticalAlignment="Center"
                                                    pu:ButtonHelper.CornerRadius="15"
                                                    pu:IconHelper.FontFamily="{StaticResource PanuonIconFont}"
                                                    pu:IconHelper.FontSize="12"
                                                    pu:IconHelper.Margin="0,0,10,0"
                                                    Background="#009688"
                                                    Click="Button_Click_Excel"
                                                    CommandParameter="2"
                                                    Content="数据导入"
                                                    Foreground="White" />
                                            </Grid>

                                        </Grid>
                                    </Grid>
                                    <!--  怪物  -->
                                    <Grid Grid.Row="1" Grid.Column="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
