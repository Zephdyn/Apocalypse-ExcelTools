<Window
    x:Class="ExcelTools.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ExcelTools"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpf="clr-namespace:excelTools.WPF"
    Title="Window"
    Width="1000"
    Height="620"
    MinWidth="1000"
    MinHeight="620"
    d:DataContext="{d:DesignInstance Type=wpf:WpfInfo}"
    AllowsTransparency="True"
    Visibility="Visible"
    WindowStyle="None"
    mc:Ignorable="d">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="5" />
    </WindowChrome.WindowChrome>
    <Grid Background="#424242">
        <Grid.RowDefinitions>
            <RowDefinition Height="50*" />
            <RowDefinition Height="360*" />
            <RowDefinition Height="60" />
        </Grid.RowDefinitions>
        <!--  选择数据库  -->
        <!--  数据库config信息  -->

        <!--  顶层  -->
        <Grid
            x:Name="顶层"
            Grid.Row="0"
            Width="NaN"
            Height="60"
            Margin="1,1,1,0"
            HorizontalAlignment="Stretch"
            Background="Green"
            MouseLeftButtonDown="Border_MouseLeftButtonDown">
            <TextBlock
                Width="252"
                Height="25"
                Margin="596,12,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Text="{Binding DbConfigInfo, FallbackValue=选择数据库}" />
            <Button
                Grid.Row="0"
                Width="80"
                Height="30"
                Margin="920,13,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Click="Button_OpenDb"
                Content="选择数据库" />
            <Image
                x:Name="image"
                Width="32"
                Height="32"
                Margin="10,13,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Source="/images/logo.png" />
            <TextBlock
                x:Name="textBlock"
                Margin="56,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                FontSize="20"
                Text="Excel Tools"
                TextWrapping="Wrap" />
            <Button
                Width="180"
                Height="50"
                Margin="379,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Click="Button_Tab_1"
                Content="首页" />
        </Grid>
        <Grid
            x:Name="功能"
            Grid.Row="1"
            Margin="1,0,1,0"
            Background="White">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" />
                <ColumnDefinition Width="41*" />
            </Grid.ColumnDefinitions>
            <Grid
                x:Name="功能_侧边栏"
                Width="300"
                Height="NaN"
                VerticalAlignment="Top"
                Background="red" />
            <Grid
                x:Name="功能_内容栏"
                Grid.Column="1"
                HorizontalAlignment="Left">
                <TabControl
                    Height="NaN"
                    VerticalAlignment="Stretch"
                    BorderBrush="#FFBFBFBF"
                    Cursor=""
                    IsSynchronizedWithCurrentItem="False"
                    SelectedIndex="{Binding TabControl}">
                    <TabItem x:Name="TabItem_1" Header="首页">
                        <Grid Background="#FFF">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="84*" />
                                <RowDefinition Height="163*" />
                                <RowDefinition Height="85*" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="182*" />
                                <ColumnDefinition Width="320*" />
                                <ColumnDefinition Width="249*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                TextWrapping="Wrap"><Run Text="这是天启幻境II Excel工具" /><LineBreak /><Run Text="&#x9;" /><LineBreak /><Run Text="[说明]" /><LineBreak /><Run Text="&#x9;" /><Run Text="将" /><Run Text="excel" /><Run Text="中的数据" /><Run Text="快速将数据导入到天启幻境II的数据库中" /><LineBreak /><Run Text="&#x9;" /><LineBreak /><Run Text="[使用方法]" /><LineBreak /><Run Text="&#x9;1. 先选择数据库, 将数据库成功连接" /><LineBreak /><Run Text="&#x9;" /><Run Text="2. 选择要导入的Excel文件" /><LineBreak /><Run Text="&#x9;" /><Run Text="3. 点击导入" /></TextBlock>
                            <Button
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="80"
                                Height="30"
                                Margin="0,45,10,0"
                                HorizontalAlignment="Right"
                                Click="Button_Tab_2"
                                Content="进入Excel" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="10,10,83,10"
                                FontSize="13"
                                TextWrapping="Wrap"><Run Text="支持Excel格式" /><LineBreak /><Run Text="xls &#x9;【√】" /><LineBreak /><Run Text="xlsx &#x9;【√】★" /><LineBreak /><Run Text="" /><LineBreak /><Run Text="// 推荐使用xlsx格式" /></TextBlock>
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="400"
                                Height="80"
                                Margin="10,10,10,15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                TextWrapping="Wrap"><Run Text="当前支持数据库版本：3." /><Run Language="zh-cn" Text="3" /><Run Text=".0" /></TextBlock>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TabItem_2" Header="Excel">

                        <Grid Background="#FFF">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="150*" />
                                <RowDefinition Height="50*" />
                                <RowDefinition Height="50*" />
                                <RowDefinition Height="159*" />
                            </Grid.RowDefinitions>
                            <GroupBox
                                Width="301"
                                Height="118"
                                Margin="10,10,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Header="选择模式">
                                <Grid
                                    Width="276"
                                    Height="65"
                                    Background="#fff">
                                    <RadioButton
                                        x:Name="RadioTab2Mode"
                                        Width="101"
                                        Height="23"
                                        Margin="10,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Content="导入数据模式"
                                        IsChecked="true" />
                                    <RadioButton
                                        x:Name="RadioTab2Mode_2"
                                        Width="111"
                                        Height="22"
                                        Margin="138,10,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Content="导出示例模式" />
                                </Grid>
                            </GroupBox>
                            <TextBlock
                                Width="370"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                FontSize="14"
                                TextWrapping="Wrap"><Run Text="[模式说明]" /><LineBreak /><Run /><LineBreak /><Run Text="&#x9;导入模式： 选择Excel，导入数据库内" /><LineBreak /><Run Text="&#x9;导出模式：" /><Run Text=" " /><Run Text="导出Excel示例。" /><Run Text="(均为xlsx格式" /><LineBreak /><Run Text="[其他说明]" /><LineBreak /><Run Text="&#x9;请在关闭文件的情况下导入, 否则会打开失败" /></TextBlock>

                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="50,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_equip"
                                Content="装备" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="150,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_map"
                                Content="地图" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="250,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_monster"
                                Content="怪物" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="350,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_drop"
                                Content="掉落" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="450,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_goods"
                                Content="物品" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="550,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_shop"
                                Content="商店" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="650,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_duties"
                                Content="任务" />
                            <Button
                                Grid.Row="1"
                                Width="80"
                                Height="30"
                                Margin="750,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Click="Button_Tab_2_copyOne"
                                Content="副本" />
                        </Grid>
                    </TabItem>

                    <TabItem x:Name="TabItem_3" Header="Data">

                        <Grid Background="#FFF">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="10*" />
                                <ColumnDefinition Width="307*" />
                                <ColumnDefinition Width="319*" />
                                <ColumnDefinition Width="340*" />
                                <ColumnDefinition Width="10*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="45*" />
                                <RowDefinition Height="320*" />
                                <RowDefinition Height="45*" />
                            </Grid.RowDefinitions>
                            <DataGrid
                                x:Name="Tab_3_DataGrid"
                                Grid.Row="1"
                                Grid.Column="1"
                                Grid.ColumnSpan="3"
                                Width="Auto"
                                AutoGenerateColumns="False"
                                ItemsSource="{Binding}" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                Width="80"
                                Height="30"
                                Margin="0,8,10,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="Button_Tab_3_Writedata"
                                Content="开始导入" />
                            <TextBlock
                                x:Name="Tab_3_TextBlock"
                                Grid.Column="1"
                                Width="304"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                x:FieldModifier="public"
                                FontSize="14"
                                TextWrapping="Wrap"><Run Text="当前数据数量: " /><Run Text="0" /></TextBlock>
                            <TextBlock
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Width="304"
                                Margin="10,14,0,14"
                                HorizontalAlignment="Left"
                                FontSize="14"
                                TextAlignment="Left"
                                TextWrapping="Wrap"><Run Text="最多展示" /><Run Text="5" /><Run Text="0" /><Run Text="条数据" /></TextBlock>
                            <Canvas
                                Grid.Row="1"
                                Grid.Column="3"
                                Width="100"
                                Height="100"
                                Margin="36,182,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="2"
                                Width="304"
                                Margin="5,10,0,0"
                                HorizontalAlignment="Left"
                                FontSize="14"
                                Text="{Binding TabWriteDataNum}"
                                TextWrapping="Wrap" />
                            <ComboBox
                                x:Name="Tab_3_ComboBox_Shhet"
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="121"
                                Height="26"
                                Margin="90,10,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                DisplayMemberPath="Name"
                                SelectedValuePath="ID" />
                            <Button
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="80"
                                Height="30"
                                Margin="229,6,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Click="Button_Tab_3_GetShee"
                                Content="读取表" />
                            <TextBlock
                                Grid.Row="2"
                                Grid.Column="2"
                                Width="85"
                                Margin="0,13,0,14"
                                HorizontalAlignment="Left"
                                FontSize="14"
                                TextAlignment="Center"
                                TextWrapping="Wrap"><Run Language="zh-cn" Text="工作表" /></TextBlock>
                            <Button
                                Grid.Column="3"
                                Grid.ColumnSpan="2"
                                Width="80"
                                Height="30"
                                Margin="263,4,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Click="Button_Tab_3_brake"
                                Content="上一页" />
                        </Grid>
                    </TabItem>
                </TabControl>
            </Grid>
            <ListBox
                x:Name="listBox"
                d:ItemsSource="{d:SampleData ItemCount=5}"
                Background="#FFA22424" />
        </Grid>
        <Grid
            x:Name="底层"
            Grid.Row="2"
            Width="Auto"
            Margin="1,0,1,1"
            Background="White">
            <TextBlock
                Grid.Column="0"
                Width="115"
                Height="25"
                Margin="10,0,0,10"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Text="{Binding Version, FallbackValue=版本}" />
            <TextBlock
                Width="237"
                Height="72"
                Margin="0,0,0,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                FontSize="14"
                Foreground="#FFAAAAAA"
                TextWrapping="Wrap"><Run Text="使用第三方库：" /><LineBreak /><Run Text="NPOI" /><Run Text="&#x9;" /><Run Text="Newtonsoft.Json" /><LineBreak /><Run Text="Microsoft.Data.Sqlite" /><LineBreak /><Run Text="Panuon.WPF.UI" /></TextBlock>
        </Grid>

    </Grid>

</Window>
