<Window x:Class="ExcelTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ExcelTools" 
        mc:Ignorable="d"
        Title="Window"  Height="620" MinHeight="620"  Width="1000" MinWidth="1000" Visibility="Visible" >
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50*"/>
            <RowDefinition Height="360*"/>
            <RowDefinition Height="60*"/>
        </Grid.RowDefinitions>
        <!-- 选择数据库 -->
        <!-- 数据库config信息 -->

        <TabControl  SelectedIndex="{Binding TabControl}" BorderBrush="#FFBFBFBF" IsSynchronizedWithCurrentItem="False" Cursor="" Grid.ColumnSpan="3" Margin="0,64,0,0" Grid.RowSpan="2" >
            <TabItem x:Name="TabItem_1" Header="首页">

                <Grid Background="#FFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="84*"/>
                        <RowDefinition Height="163*"/>
                        <RowDefinition Height="85*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="182*"/>
                        <ColumnDefinition Width="320*"/>
                        <ColumnDefinition Width="249*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock TextWrapping="Wrap" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"><Run Text="这是天启幻境II Excel工具"/><LineBreak/><Run Text="&#x9;"/><LineBreak/><Run Text="[说明]"/><LineBreak/><Run Text="&#x9;"/><Run Text="将"/><Run Text="excel"/><Run Text="中的数据"/><Run Text="快速将数据导入到天启幻境II的数据库中"/><LineBreak/><Run Text="&#x9;"/><LineBreak/><Run Text="[使用方法]"/><LineBreak/><Run Text="&#x9;1. 先选择数据库, 将数据库成功连接"/><LineBreak/><Run Text="&#x9;"/><Run Text="2. 选择要导入的Excel文件"/><LineBreak/><Run Text="&#x9;"/><Run Text="3. 点击导入"/></TextBlock>
                    <Button Grid.Row="2" Content="进入Excel" Margin="0,45,10,0" Width="80" Click="Button_Tab_2" Height="30" Grid.Column="2" HorizontalAlignment="Right"/>
                    <TextBlock TextWrapping="Wrap" Grid.Column="2" Margin="10,10,83,10" FontSize="13"><Run Text="支持Excel格式"/><LineBreak/><Run Text="xls &#x9;【√】"/><LineBreak/><Run Text="xlsx &#x9;【√】★"/><LineBreak/><Run Text=""/><LineBreak/><Run Text="// 推荐使用xlsx格式"/></TextBlock>
                    <TextBlock TextWrapping="Wrap" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Margin="10,10,10,15" Height="80" Width="400"><Run Text="当前支持数据库版本：3."/><Run Language="zh-cn" Text="2"/><Run Text=".0"/></TextBlock>
                </Grid>
            </TabItem>
            <TabItem x:Name="TabItem_2" Header="Excel">

                <Grid Background="#FFF">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="150*"/>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="159*"/>
                    </Grid.RowDefinitions>
                    <GroupBox  Header="选择模式" HorizontalAlignment="Left" Height="118" Margin="10,10,0,0" VerticalAlignment="Top" Width="301">
                        <Grid Background="#fff" Height="65" Width="276">
                            <RadioButton x:Name="RadioTab2Mode" Content="导入数据模式" HorizontalAlignment="Left" Height="23" Margin="10,10,0,0" VerticalAlignment="Top" Width="101" IsChecked="true"/>
                            <RadioButton x:Name="RadioTab2Mode_2"  Content="导出示例模式" HorizontalAlignment="Left" Height="22" Margin="138,10,0,0" VerticalAlignment="Top" Width="111"/>
                        </Grid>
                    </GroupBox>
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top" TextWrapping="Wrap" Margin="0,10,0,0" Width="370" FontSize="14"><Run Text="[模式说明]"/><LineBreak/><Run/><LineBreak/><Run Text="&#x9;导入模式： 选择Excel，导入数据库内"/><LineBreak/><Run Text="&#x9;导出模式："/><Run Text=" "/><Run Text="导出Excel示例。"/><Run Text="(均为xlsx格式"/><LineBreak/><Run Text="[其他说明]"/><LineBreak/><Run Text="&#x9;请在关闭文件的情况下导入, 否则会打开失败"/></TextBlock>

                    <Button Content="装备" HorizontalAlignment="Left" Margin="50,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_equip" Height="30" Grid.Row="1"/>
                    <Button Content="地图" HorizontalAlignment="Left" Margin="150,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_map" Height="30" Grid.Row="1"/>
                    <Button Content="怪物" HorizontalAlignment="Left" Margin="250,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_monster" Height="30" Grid.Row="1"/>
                    <Button Content="掉落" HorizontalAlignment="Left" Margin="350,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_drop" Height="30" Grid.Row="1"/>
                    <Button Content="物品" HorizontalAlignment="Left" Margin="450,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_goods" Height="30" Grid.Row="1" />
                    <Button Content="商店" HorizontalAlignment="Left" Margin="550,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_shop" Height="30" Grid.Row="1"/>
                    <Button Content="任务" HorizontalAlignment="Left" Margin="650,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_duties" Height="30" Grid.Row="1"/>
                    <Button Content="副本" HorizontalAlignment="Left" Margin="750,0,0,0" VerticalAlignment="Center" Width="80" Click="Button_Tab_2_copyOne" Height="30" Grid.Row="1"/>
                </Grid>
            </TabItem>

            <TabItem x:Name="TabItem_3" Header="Data">

                <Grid Background="#FFF">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="10*"/>
                        <ColumnDefinition Width="307*"/>
                        <ColumnDefinition Width="319*"/>
                        <ColumnDefinition Width="340*"/>
                        <ColumnDefinition Width="10*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="320*"/>
                        <RowDefinition Height="45*"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="Tab_3_DataGrid" ItemsSource="{Binding}" AutoGenerateColumns="False"  Width="Auto"  Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" />
                    <Button Content="开始导入" HorizontalAlignment="Right" Margin="0,8,10,0" VerticalAlignment="Top" Width="80" Click="Button_Tab_3_Writedata" Height="30" Grid.Row="2" Grid.Column="3" Grid.ColumnSpan="2"/>
                    <TextBlock x:Name="Tab_3_TextBlock" x:FieldModifier="public" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,10,0,0" Grid.Column="1" Width="304" FontSize="14"><Run Text="当前数据数量: "/><Run Text="0"/></TextBlock>
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Margin="10,14,0,14" Width="304" FontSize="14" Grid.Row="2" Grid.ColumnSpan="2" TextAlignment="Left"><Run Text="最多展示"/><Run Text="5"/><Run Text="0"/><Run Text="条数据"/></TextBlock>
                    <Canvas Grid.Column="3" HorizontalAlignment="Left" Height="100" Margin="36,182,0,0" Grid.Row="1" VerticalAlignment="Top" Width="100"/>
                    <TextBlock Text="{Binding TabWriteDataNum}"  HorizontalAlignment="Left" TextWrapping="Wrap" Margin="5,10,0,0" Grid.Column="2" Width="304" FontSize="14"></TextBlock>
                    <ComboBox x:Name="Tab_3_ComboBox_Shhet" DisplayMemberPath="Name" SelectedValuePath="ID" Grid.Column="2" HorizontalAlignment="Left" Height="26" Margin="90,10,0,0" Grid.Row="2" VerticalAlignment="Top" Width="121"/>
                    <Button Content="读取表" HorizontalAlignment="Left" Margin="229,6,0,0" VerticalAlignment="Top" Width="80" Click="Button_Tab_3_GetShee" Height="30" Grid.Row="2" Grid.Column="2"/>
                    <TextBlock HorizontalAlignment="Left" TextWrapping="Wrap" Margin="0,13,0,14" Width="85" FontSize="14" Grid.Row="2" Grid.Column="2" TextAlignment="Center"><Run Language="zh-cn" Text="工作表"/></TextBlock>
                    <Button Content="上一页" HorizontalAlignment="Right" Margin="263,4,0,0" VerticalAlignment="Top" Width="80" Click="Button_Tab_3_brake" Height="30" Grid.Column="3" Grid.ColumnSpan="2"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 软件版本 -->
        <Grid Grid.ColumnSpan="3">
            <TextBlock Text="{Binding DbConfigInfo}" HorizontalAlignment="Left" Margin="10,10,0,0" VerticalAlignment="Top" Height="25" Width="252"/>
            <Button Grid.Row="0" Content="选择数据库" HorizontalAlignment="Left" Margin="268,5,0,0" VerticalAlignment="Top" Width="80" Click="Button_OpenDb" Height="30"/>
            <Button Content="首页" HorizontalAlignment="Right" Margin="0,10,10,0" VerticalAlignment="Top" Width="80" Click="Button_Tab_1" Height="30"/>
        </Grid>
        <Grid Grid.Row="2" HorizontalAlignment="Stretch" Width="Auto">
            <TextBlock Grid.Column="0" Text="{Binding Version}" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Height="25" Width="115"/>
            <TextBlock TextWrapping="Wrap" HorizontalAlignment="Right" VerticalAlignment="Bottom" FontSize="14" Height="72" Width="237" Foreground="#FFAAAAAA" Margin="0,0,0,0"><Run Text="使用第三方库："/><LineBreak/><Run Text="NPOI"/><Run Language="zh-cn" Text="&#x9;"/><Run Text="Newtonsoft.Json"/><LineBreak/><Run Text="Microsoft.Data.Sqlite"/><LineBreak/><Run Text="Panuon.UI.Silver"/></TextBlock>
        </Grid>
    </Grid>

</Window>
