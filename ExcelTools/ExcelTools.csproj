<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Version>3.1.0</Version>
    <Authors>枭</Authors>
    <Description>天启幻境II - Excel快速操作工具</Description>
    <Copyright>apocalypse - Tapdrd</Copyright>
    <NeutralLanguage>zh-CN</NeutralLanguage>
    <AssemblyVersion>3.1.0</AssemblyVersion>
    <!-- 依赖链(NPOI -> SixLabors.ImageSharp, Microsoft.Data.Sqlite -> SQLitePCLRaw)存在上游未修复的传递漏洞告警,
         这里只对直接依赖做审计, 避免每次编译输出大量无法处理的 NU1902/NU1903 -->
    <NuGetAuditMode>direct</NuGetAuditMode>
    <UseWindowsForms>False</UseWindowsForms>
    <PackageIcon>logo.png</PackageIcon>
    <ApplicationIcon>window\favicon.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 本机调试输出目录, 只有存在 E:\apo 时才生效, 其他机器/CI 上走默认的 bin\Debug -->
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU' And Exists('E:\apo')">
    <OutputPath>E:\apo\C#\debug\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="images\excel\copy.png" />
    <None Remove="images\excel\drop.png" />
    <None Remove="images\excel\equip.png" />
    <None Remove="images\excel\goods.png" />
    <None Remove="images\excel\map.png" />
    <None Remove="images\excel\monster.png" />
    <None Remove="images\excel\shop.png" />
    <None Remove="images\excel\skill.png" />
    <None Remove="images\excel\task.png" />
    <None Remove="images\Microsoft.Data.Sqlite.png" />
    <None Remove="images\Newtonsoft.Json.png" />
    <None Remove="images\NPOI.png" />
    <None Remove="images\Panuon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="window\favicon.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NPOI" Version="2.7.4" />
    <PackageReference Include="Panuon.WPF" Version="1.1.2.2" />
    <PackageReference Include="Panuon.WPF.UI" Version="1.2.4.7" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\about\Microsoft.Data.Sqlite.png" />
    <Resource Include="images\about\Newtonsoft.Json.png" />
    <Resource Include="images\about\NPOI.png" />
    <Resource Include="images\about\Panuon.png" />
    <Resource Include="images\excel\copy.png" />
    <Resource Include="images\excel\drop.png" />
    <Resource Include="images\excel\goods.png" />
    <Resource Include="images\excel\map.png" />
    <Resource Include="images\excel\equip.png" />
    <Resource Include="images\excel\monster.png" />
    <Resource Include="images\excel\shop.png" />
    <Resource Include="images\excel\skill.png" />
    <Resource Include="images\excel\task.png" />
    <Resource Include="window\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
    <None Update="window\logo.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
